{
  "expo": {
    "name": "AI Voice App",
    "slug": "my-first-project-expo",
    "scheme": "aivoiceapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow AI Voice App to record your thoughts."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shivamagarwal.aivoiceapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "owner": "shivamexpodevs-team",
    "extra": {
      "eas": {
        "projectId": "ade29100-7720-4751-9c7e-c1c754261820"
      }
    }
  }
}
